{
  "name": "pam",
  "version": "0.1.0",
  "private": true,
  "description": "PAM — a social, relational system connecting people to people at services and facilities.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @pam/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:a11y": "pnpm --filter @pam/web test:a11y",
    "lint": "pnpm -r lint",
    "db:seed-admin": "pnpm --filter @pam/db seed:admin"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
