# Copy to .env.local. Never commit a filled-in copy — this repo is public.

# Supabase. The anon key is safe in the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps (§5.1). Restrict this key by HTTP referrer and bundle ID before
# using it anywhere but localhost.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# PAM's support line, shown in the HelpBar on every screen (§2.4). E.164.
NEXT_PUBLIC_SUPPORT_PHONE=

# --- Server-side only. These belong in Supabase Edge Function secrets, never
# --- in this file and never prefixed NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_MESSAGING_SERVICE_SID=
# ANTHROPIC_API_KEY=
