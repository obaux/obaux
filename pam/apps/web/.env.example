# Copy to .env.local. Never commit a filled-in copy of the server-side block —
# this repository is public.

# --- Supabase -------------------------------------------------------------
# Project: pam (shobqzuhicoiymtumiaz), us-east-1.
#
# The publishable key is designed to ship in client JavaScript; RLS is what
# protects the data, and the policy set is verified by
# `pnpm --filter @pam/db test`. It is still left blank here so the value in the
# repo can never drift from the one in the dashboard — copy it from
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://shobqzuhicoiymtumiaz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Where PAM lives on the web -------------------------------------------
# The base of every invite link that goes out by text. Must be the public URL,
# not localhost, in any environment that can send an invite. On Vercel this is
# set in the project's Environment Variables; the Capacitor build must set it
# explicitly, because the app shell's own origin is a local file server.
NEXT_PUBLIC_APP_URL=

# --- Google Maps (§5.1) ---------------------------------------------------
# Restrict by HTTP referrer and bundle ID before using anywhere but localhost.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Support line (§2.4) --------------------------------------------------
# First-paint fallback only. The live value is app_settings.support_phone, which
# an admin can change without a deploy. Keep them in step.
NEXT_PUBLIC_SUPPORT_PHONE=+12673095265

# --- Server-side only -----------------------------------------------------
# These belong in Supabase Edge Function secrets. Never prefix them
# NEXT_PUBLIC_, and never put real values in this file.
# SUPABASE_SERVICE_ROLE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_MESSAGING_SERVICE_SID=
# ANTHROPIC_API_KEY=
