 import { PeopleHomeView, type HomePerson, type PeopleState } from './PeopleHomeView';
 
 /** A case manager's home: the people on their caseload. */
+type VisitRow = { member_id: string; starts_at: string; status: string | null; services: { name: string | null } | null };
+// Picture-only stand-in words (Sage and Lena write the real ones).
+const STAND_IN: Record<string, { next: string; went: string; missed: string }> = {
+  en: { next: 'Next visit', went: 'Went', missed: 'Missed' },
+  ar: { next: 'الزيارة القادمة', went: 'حضر', missed: 'لم يحضر' },
+};
+function useCaseloadVisits(ids: readonly string[]): Record<string, VisitRow[]> {
+  const [rows, setRows] = useState<Record<string, VisitRow[]>>({});
+  const key = ids.join(',');
+  useEffect(() => {
+    if (!key) return;
+    void (async () => {
+      const { createClient } = await import('@/lib/supabase');
+      const { data } = await createClient()
+        .from('appointments')
+        .select('member_id,starts_at,status,services(name)')
+        .in('member_id', key.split(','))
+        .neq('status', 'cancelled');
+      const by: Record<string, VisitRow[]> = {};
+      for (const r of (data ?? []) as unknown as VisitRow[]) (by[r.member_id] ??= []).push(r);
+      setRows(by);
+    })();
+  }, [key]);
+  return rows;
+}
+
 export function CaseloadHome() {
   const { t, tPlain } = useI18n();
   const router = useRouter();
   const { state: caseload, refresh } = useCaseload(true);
   const examplePeople = useExamplePeople();
+  const { locale } = useI18n();
+  const visits = useCaseloadVisits(caseload.status === 'ready' ? caseload.members.map((m) => m.id) : []);
+  const words = STAND_IN[locale] ?? STAND_IN['en']!;
+  const fmt = new Intl.DateTimeFormat(locale === 'ar' ? 'ar-u-nu-latn' : 'en-US', { weekday: 'short', hour: 'numeric', minute: '2-digit' });
+  const fmtDay = new Intl.DateTimeFormat(locale === 'ar' ? 'ar-u-nu-latn' : 'en-US', { month: 'short', day: 'numeric' });
+  const visitLine = (id: string): string[] => {
+    const mine = (visits[id] ?? []).slice().sort((a, b) => a.starts_at.localeCompare(b.starts_at));
+    const next = mine.find((v) => new Date(v.starts_at).getTime() > Date.now());
+    if (next) return [`${words.next}: ${fmt.format(new Date(next.starts_at))}`];
+    const last = mine[mine.length - 1];
+    if (!last) return [];
+    return [`${last.status === 'attended' ? words.went : words.missed} ${fmtDay.format(new Date(last.starts_at))}`];
+  };
+  const missedChip = (id: string): { label: string; tone: 'warning' } | null => {
+    const mine = (visits[id] ?? []).slice().sort((a, b) => a.starts_at.localeCompare(b.starts_at));
+    const last = mine[mine.length - 1];
+    return last && last.status !== 'attended' && new Date(last.starts_at).getTime() < Date.now()
+      ? { label: `${words.missed} ${fmtDay.format(new Date(last.starts_at))}`, tone: 'warning' }
+      : null;
+  };
 
   // The real list when there is one; the example people otherwise, as on
