+import { CalloutCard } from '../components/CalloutCard';
+import { HowTo } from '../components/HowTo';
+import { LegalLink } from '../components/LegalLink';
+import { Body, Bullets, Lead, P, Section } from '../components/Prose';
+import { NEW_NUMBER_URL } from '../lib/links';
+
+/**
+ * Support post: Got a new phone number? (everyone). Words by Sage, signed (A29, 14 October 2026, ledger e708a7e8);
+ * Will's request: "add that as an article inside the support website and in the article it has a callout to this form
+ * and have the post facilitate this process". It matches Ava's D-567 (the app's New number? form at
+ * /signin/new-number/). "Sign in", "New number?" and "Send" are the app's labels: keep them matching if they change.
+ * Held until a84 is signed and D-567 ships.
+ */
+export function NewPhoneNumber() {
+  return (
+    <Body>
+      <Lead>
+        Your Pam account is tied to your phone number. If your number changed, you can ask us to move your account to the
+        new one. It’s the same account, with everything in it.
+      </Lead>
+
+      <Section title="What to have ready">
+        <Bullets
+          items={[
+            'Your new phone, in your hand. Pam texts it a code first, to check it’s yours.',
+            'Your old phone number.',
+            'Your first and last name, and your city, as they are on your account.',
+            'If you can, the name of someone on Pam who knows you, like your guide. It helps us check it’s you. You can leave it out.',
+          ]}
+        />
+      </Section>
+
+      <Section title="How to ask">
+        <HowTo
+          steps={[
+            'Open Pam and go to Sign in.',
+            'Tap New number? at the bottom.',
+            'Type your new number, then the code we text to it.',
+            'Fill in the form and tap Send.',
+          ]}
+        />
+        <CalloutCard
+          title="Ready to move your account?"
+          line="Have your new phone with you. Pam texts it a code first."
+          label="Start with your new number"
+          href={NEW_NUMBER_URL}
+        />
+      </Section>
+
+      <Section title="What happens next">
+        <P>
+          A person on the Pam team checks every request by hand. We may call your new number to make sure it’s really you.
+          Nothing moves until then.
+        </P>
+        <P>Pam won’t text you when it’s done. Come back and sign in with your new number to see the answer.</P>
+        <Bullets
+          items={[
+            'If we say yes, your account moves to your new number. Sign in with your new number to open it. Your old number no longer opens your account.',
+            'If we say no, your account stays as it was, and we delete your new number from Pam at once. If you think we got it wrong, contact Pam.',
+          ]}
+        />
+      </Section>
+
+      <Section title="When this won’t work">
+        <Bullets
+          items={[
+            'If you already joined Pam with your new number, there is nothing to move it onto. Contact Pam.',
+            'The Pam team’s own admin accounts can’t be moved this way.',
+          ]}
+        />
+      </Section>
+
+      <P>How long we keep what you send is on our Privacy page.</P>
+      <LegalLink kind="privacy" label="Read the privacy policy" variant="read-more" />
+    </Body>
+  );
+}
