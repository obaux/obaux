+import * as stylex from '@stylexjs/stylex';
+import { Heading } from '@astryxdesign/core/Heading';
+import { Text } from '@astryxdesign/core/Text';
+import { VStack } from '@astryxdesign/core/VStack';
+import { website } from '../lib/website.stylex';
+import { type } from '../lib/website-type.stylex';
+import { SoftButton } from './SoftButton';
+
+const styles = stylex.create({
+  // The same soft grey card as "Still stuck?": radius 24, a hairline, 24px inside on a phone and 32px from 900px.
+  card: {
+    padding: { default: '24px', '@media (min-width: 900px)': '32px' },
+    boxSizing: 'border-box',
+    borderRadius: '24px',
+    borderWidth: '1px',
+    borderStyle: 'solid',
+    borderColor: website['--website-border-subtle'],
+    backgroundColor: website['--website-surface-muted'],
+    color: website['--website-text-primary'],
+    maxWidth: '760px',
+  },
+  title: { color: website['--website-text-primary'], margin: 0 },
+  line: { color: website['--website-text-primary'], margin: 0 },
+  // Full width on a phone, as wide as its words from 900px (the same rule as "Write to us").
+  button: { alignSelf: { default: 'stretch', '@media (min-width: 900px)': 'flex-start' } },
+});
+
+/** A call-out inside a post: a heading, one line, and one button to somewhere else (a form in the app). */
+export function CalloutCard({ title, line, label, href }: { readonly title: string; readonly line: string; readonly label: string; readonly href: string }) {
+  return (
+    <VStack gap={3} xstyle={styles.card}>
+      <Heading level={3} xstyle={[type.heading_title24, styles.title]}>
+        {title}
+      </Heading>
+      <Text as="p" xstyle={[type.lead_17, styles.line]}>
+        {line}
+      </Text>
+      <SoftButton label={label} href={href} xstyle={styles.button} />
+    </VStack>
+  );
+}
